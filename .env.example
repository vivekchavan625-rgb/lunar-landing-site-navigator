NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173
COOKIE_SECURE=false

# app_user is the restricted NOBYPASSRLS role. The admin URL is for migrations ONLY.
POSTGRES_ADMIN_PASSWORD=change_me
DATABASE_ADMIN_URL=postgresql://postgres:change_me@localhost:5432/lunar_navigator
APP_DB_PASSWORD=change_me
DATABASE_URL=postgresql://app_user:change_me@localhost:5432/lunar_navigator

SCIENCE_ENGINE_URL=http://localhost:8000
SCIENCE_TIMEOUT_MS=60000
SPICE_KERNEL_DIR=./data/kernels
SPICE_META_KERNEL=./data/kernels/mission.tm
KERNEL_MANIFEST=./data/metadata/kernel_manifest.json
TERRAIN_DATA_DIR=./data/terrain

JPL_HORIZONS_BASE_URL=https://ssd.jpl.nasa.gov/api/horizons.api
HORIZONS_ENABLED=true

LOG_LEVEL=info
REPORT_STORAGE_DIR=./storage/reports
